# Copie para .env na raiz do projeto: cp .env.example .env
# O mesmo arquivo é lido pela API (prefixo API_) e pelo frontend (prefixo VITE_).

# --- API (FastAPI) ---
# Origens autorizadas a chamar a API, separadas por vírgula.
API_CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite) ---
# Variáveis VITE_* acabam no bundle do navegador: nunca coloque segredos aqui.
VITE_API_URL=http://localhost:8000
