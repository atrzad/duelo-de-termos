[Unit]
Description=Duelo de Termos - jogo de palavras (API + frontend, porta 3500, só localhost)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/Projects/duelo-de-termos/apps/api
ExecStart=%h/Projects/duelo-de-termos/apps/api/.venv/bin/uvicorn app.main:socket_app --host 127.0.0.1 --port 3500
Restart=always
RestartSec=3
NoNewPrivileges=yes
UMask=0077
MemoryMax=512M

[Install]
WantedBy=default.target
